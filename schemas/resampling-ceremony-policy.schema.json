{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/resampling-ceremony-policy.schema.json",
    "title": "Resampling-Null Roster Ceremony Policy",
    "description": "Registered external ceremony verifier policy. It declares the exact Sigstore, drand, and Node contracts but does not itself establish a live ceremony.",
    "type": "object",
    "x-pneuma-schema-kind": "resampling-study",
    "x-pneuma-version": "1",
    "required": ["record_kind", "schema_version", "study_id", "qualification_universe_sha256", "selection_program_sha256", "precommit_sha256", "drand", "sigstore", "node", "public_key_ed25519_hex"],
    "properties": {
        "record_kind": {"const": "resampling_roster_ceremony_policy_v1"},
        "schema_version": {"const": "1"},
        "study_id": {"type": "string", "minLength": 1},
        "qualification_universe_sha256": {"$ref": "#/$defs/sha256"},
        "selection_program_sha256": {"$ref": "#/$defs/sha256"},
        "precommit_sha256": {"$ref": "#/$defs/sha256"},
        "drand": {
            "type": "object",
            "required": ["chain_hash", "scheme", "client_version", "group_hash", "genesis_time", "period"],
            "properties": {
                "chain_hash": {"$ref": "#/$defs/sha256"},
                "scheme": {"const": "pedersen-bls-chained"},
                "client_version": {"const": "drand-client==1.4.2"},
                "group_hash": {"$ref": "#/$defs/sha256"},
                "genesis_time": {"type": "integer", "minimum": 0},
                "period": {"type": "integer", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
        },
        "sigstore": {
            "type": "object",
            "required": ["contract_id", "verifier_source_sha256", "required_rekor_log", "bundle_format"],
            "properties": {
                "contract_id": {"const": "sigstore-bundle-verification-v1"},
                "verifier_source_sha256": {"$ref": "#/$defs/sha256"},
                "required_rekor_log": {"const": "rekor-public-good"},
                "bundle_format": {"const": "sigstore-bundle-v0.3"}
            },
            "additionalProperties": false
        },
        "node": {
            "type": "object",
            "required": ["contract_id", "program_sha256", "runtime", "output_schema"],
            "properties": {
                "contract_id": {"const": "node-roster-selection-v1"},
                "program_sha256": {"$ref": "#/$defs/sha256"},
                "runtime": {"const": "nodejs-22"},
                "output_schema": {"const": "resampling-eligibility-manifest-v1"}
            },
            "additionalProperties": false
        },
        "public_key_ed25519_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "additionalProperties": false,
    "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
