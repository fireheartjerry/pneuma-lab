{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-pilot-admission-receipt.schema.json",
    "title": "Cloud Per-Worker Pilot Admission Receipt",
    "description": "Hash-bound measurement record for one worker in the approved two-worker admission; it is neither an authorization nor a scientific result.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.3.0",
    "required": ["record_kind", "schema_version", "protocol_sha256", "architecture_sha256", "authorization_sha256", "image_sha256", "input_lock_sha256", "code_sha256", "worker_index", "instance_id", "measurement_evidence_sha256", "rung", "compute", "gates", "measurements"],
    "properties": {
        "record_kind": {"const": "cloud_pilot_admission_receipt"},
        "schema_version": {"const": "0.3.0"},
        "protocol_sha256": {"$ref": "#/$defs/digest"},
        "architecture_sha256": {"$ref": "#/$defs/digest"},
        "authorization_sha256": {"$ref": "#/$defs/digest"},
        "image_sha256": {"$ref": "#/$defs/digest"},
        "input_lock_sha256": {"$ref": "#/$defs/digest"},
        "code_sha256": {"$ref": "#/$defs/digest"},
        "worker_index": {"enum": [0, 1]},
        "instance_id": {"type": "string", "pattern": "^i-[0-9a-f]{8,17}$"},
        "measurement_evidence_sha256": {"$ref": "#/$defs/digest"},
        "rung": {"enum": ["l40s-tp1-32768", "l40s-tp1-65536"]},
        "compute": {
            "type": "object",
            "required": ["instance_type", "vcpus", "gpu_count", "usable_gpu_memory_gib"],
            "properties": {
                "instance_type": {"const": "g6e.2xlarge"},
                "vcpus": {"const": 8},
                "gpu_count": {"const": 1},
                "usable_gpu_memory_gib": {"const": 44}
            },
            "additionalProperties": false
        },
        "gates": {
            "type": "object",
            "required": ["oom", "tool_call", "output_parity", "p10_throughput"],
            "properties": {
                "oom": {"type": "boolean"},
                "tool_call": {"type": "boolean"},
                "output_parity": {"type": "boolean"},
                "p10_throughput": {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "measurements": {
            "type": "object",
            "required": ["peak_gpu_memory_gib", "p10_output_tokens_per_second", "tool_call_cases", "tool_call_passes", "output_parity_cases", "output_parity_passes"],
            "properties": {
                "peak_gpu_memory_gib": {"type": "number", "minimum": 0, "maximum": 44},
                "p10_output_tokens_per_second": {"type": "number", "exclusiveMinimum": 0},
                "tool_call_cases": {"type": "integer", "minimum": 1},
                "tool_call_passes": {"type": "integer", "minimum": 0},
                "output_parity_cases": {"type": "integer", "minimum": 1},
                "output_parity_passes": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
