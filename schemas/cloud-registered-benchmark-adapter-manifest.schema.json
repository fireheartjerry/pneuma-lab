{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-registered-benchmark-adapter-manifest.schema.json",
    "title": "Registered Benchmark Adapter Manifest",
    "description": "Digest-bound executable binding for the real benchmark surfaces; no fixture executable is accepted.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "status", "adapters"],
    "properties": {
        "record_kind": {"const": "cloud_registered_benchmark_adapter_manifest"},
        "schema_version": {"const": "0.1.0"},
        "status": {"const": "prelaunch_source_binding"},
        "adapters": {
            "type": "object",
            "required": ["swe_multilang", "tau2"],
            "properties": {
                "swe_multilang": {"$ref": "#/$defs/adapter"},
                "tau2": {"$ref": "#/$defs/adapter"}
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "$defs": {
        "adapter": {
            "type": "object",
            "required": ["argv", "source_repository", "source_revision", "source_snapshot_sha256", "executable_relative_path"],
            "properties": {
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "source_repository": {"type": "string", "minLength": 1},
                "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "executable_relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+"}
            },
            "additionalProperties": false
        }
    }
}
