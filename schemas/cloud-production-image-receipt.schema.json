{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-production-image-receipt.schema.json",
    "title": "Production Image Receipt",
    "description": "Immutable production role image with OCI identity, BuildKit provenance, and signed digest approval. SBOM records are optional retained evidence. It is non-scientific evidence and never authorizes a study.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.2.0",
    "required": [
        "record_kind",
        "schema_version",
        "evidence_class",
        "role",
        "source_commit",
        "source_closure",
        "dockerfile",
        "base_image",
        "image_ref",
        "image_digest",
        "oci",
        "buildx_metadata_sha256",
        "provenance",
        "digest_approval",
        "build",
        "surface_e2e_status",
    ],
    "properties": {
        "record_kind": {"const": "cloud_production_image_receipt"},
        "schema_version": {"const": "0.2.0"},
        "evidence_class": {"const": "production_surface_non_scientific"},
        "role": {"enum": ["controller", "model-server", "benchmark-worker"]},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_closure": {
            "type": "object",
            "required": [
                "commit",
                "tree_object_id",
                "manifest_sha256",
                "file_count",
                "path",
            ],
            "properties": {
                "commit": {"$ref": "#/$defs/commit"},
                "tree_object_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "manifest_sha256": {"$ref": "#/$defs/sha256"},
                "file_count": {"type": "integer", "minimum": 1},
                "path": {"const": "source-closure.json"},
            },
            "additionalProperties": false,
        },
        "dockerfile": {
            "type": "string",
            "pattern": "^infra/docker/(controller|model-server|benchmark-worker)/Dockerfile$",
        },
        "base_image": {
            "type": "object",
            "required": ["repository", "digest", "platform"],
            "properties": {
                "repository": {"const": "docker.io/vllm/vllm-openai"},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "platform": {"const": "linux/amd64"},
            },
            "additionalProperties": false,
        },
        "image_ref": {
            "type": "string",
            "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.us-east-1\\.amazonaws\\.com/pneuma-official-production-(controller|model-server|benchmark-worker)@sha256:[0-9a-f]{64}$",
        },
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "oci": {
            "type": "object",
            "required": [
                "root_index_digest",
                "root_index_media_type",
                "child_digest",
                "child_media_type",
                "child_os",
                "child_architecture",
                "root_to_child_verified",
                "attestation_descriptor_digest",
                "attestation_media_type",
                "attestation_manifest_sha256",
                "in_toto_statement_digest",
                "in_toto_statement_media_type",
            ],
            "properties": {
                "root_index_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                },
                "root_index_media_type": {"type": "string", "minLength": 1},
                "child_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "child_media_type": {"type": "string", "minLength": 1},
                "child_os": {"const": "linux"},
                "child_architecture": {"const": "amd64"},
                "root_to_child_verified": {"const": true},
                "attestation_descriptor_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                },
                "attestation_media_type": {"type": "string", "minLength": 1},
                "attestation_manifest_sha256": {"$ref": "#/$defs/sha256"},
                "in_toto_statement_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                },
                "in_toto_statement_media_type": {"type": "string", "minLength": 1},
            },
            "additionalProperties": false,
        },
        "buildx_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "sbom": {
            "type": "object",
            "required": [
                "format",
                "tool",
                "version",
                "release_url",
                "release_tar_sha256",
                "sha256",
                "byte_count",
            ],
            "properties": {
                "format": {"const": "spdx-json"},
                "tool": {"const": "syft"},
                "version": {"const": "1.50.0"},
                "release_url": {
                    "const": "https://github.com/anchore/syft/releases/download/v1.50.0/syft_1.50.0_linux_amd64.tar.gz"
                },
                "release_tar_sha256": {
                    "const": "bf7b29ff57f06da30918266a0e1c2885a8f99784798d1bdb1628886aa015d788"
                },
                "sha256": {"$ref": "#/$defs/sha256"},
                "byte_count": {"type": "integer", "minimum": 1},
            },
            "additionalProperties": false,
        },
        "provenance": {
            "type": "object",
            "required": [
                "attestation_format",
                "descriptor_digest",
                "manifest_sha256",
                "in_toto_statement_digest",
                "builder",
                "source_uri",
            ],
            "properties": {
                "attestation_format": {"const": "buildkit-in-toto-provenance"},
                "descriptor_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                },
                "manifest_sha256": {"$ref": "#/$defs/sha256"},
                "in_toto_statement_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                },
                "builder": {"const": "docker-buildx-provenance-mode-max"},
                "source_uri": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
            },
            "additionalProperties": false,
        },
        "digest_approval": {
            "type": "object",
            "required": [
                "record_sha256",
                "signed_payload_sha256",
                "signature_ed25519_b64",
                "signer",
            ],
            "properties": {
                "record_sha256": {"$ref": "#/$defs/sha256"},
                "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
                "signature_ed25519_b64": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                },
                "signer": {
                    "type": "object",
                    "required": ["provider", "key_id", "algorithm"],
                    "properties": {
                        "provider": {"const": "aws-kms"},
                        "key_id": {"type": "string", "minLength": 1},
                        "algorithm": {"const": "ED25519_SHA_512"},
                    },
                    "additionalProperties": false,
                },
            },
            "additionalProperties": false,
        },
        "build": {
            "type": "object",
            "required": [
                "platform",
                "tag_mutability",
                "scan_on_push",
                "encryption",
                "source_date_epoch",
                "network",
                "model_download",
                "benchmark_execution",
            ],
            "properties": {
                "platform": {"const": "linux/amd64"},
                "tag_mutability": {"const": "IMMUTABLE"},
                "scan_on_push": {"const": true},
                "encryption": {"const": "AES256"},
                "source_date_epoch": {"type": "integer", "minimum": 0},
                "network": {"const": "buildkit-default-no-runtime-workload"},
                "model_download": {"const": false},
                "benchmark_execution": {"const": false},
            },
            "additionalProperties": false,
        },
        "surface_e2e_status": {"const": "pending_bounded_surface_e2e"},
    },
    "additionalProperties": false,
    "$defs": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    },
}
