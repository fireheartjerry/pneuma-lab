{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/pneuma-brain-corpus-authorization.schema.json",
    "title": "PneumaBrainCorpusAuthorization",
    "description": "Human-review authorization artifact for the unified PneumaBrain-v0 training corpus. This is the single human gate above the per-lane readiness registry and the per-dataset estimator authorization. A committed template carries decision=not_authorized and is schema-valid without binding hashes; a human replaces it with decision=authorized and the full source/split/code bindings to begin a run. This schema authorizes nothing by itself.",
    "type": "object",
    "x-pneuma-schema-kind": "training-authorization",
    "x-pneuma-version": "0.1.0",
    "required": [
        "authorization_schema_version",
        "authorization_id",
        "corpus_id",
        "decision",
        "scope",
        "release_authorization",
        "runtime_integration"
    ],
    "properties": {
        "authorization_schema_version": { "const": "0.1.0" },
        "authorization_id": { "type": "string", "minLength": 1 },
        "corpus_id": { "const": "pneuma-brain-v0" },
        "decision": { "enum": ["not_authorized", "authorized"] },
        "scope": { "const": "local_research" },
        "corpus_manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "member_lanes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
        },
        "members": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "lane_id",
                    "source_traces_sha256",
                    "split_manifest_sha256"
                ],
                "properties": {
                    "lane_id": { "type": "string", "minLength": 1 },
                    "source_traces_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "split_manifest_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                },
                "additionalProperties": false
            }
        },
        "authorized_code_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reviewed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "release_authorization": { "const": "not_authorized" },
        "runtime_integration": { "const": "none" }
    },
    "allOf": [
        {
            "if": {
                "properties": { "decision": { "const": "authorized" } },
                "required": ["decision"]
            },
            "then": {
                "required": [
                    "corpus_manifest_sha256",
                    "member_lanes",
                    "members",
                    "authorized_code_commit",
                    "reviewer",
                    "reviewed_at"
                ]
            }
        }
    ],
    "additionalProperties": false
}
