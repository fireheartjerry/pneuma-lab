{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-pilot-protocol.schema.json",
    "title": "Cloud Pilot Protocol",
    "description": "Frozen two-worker admission protocol only; it does not authorize or record a pilot execution.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.2.0",
    "required": ["record_kind", "schema_version", "max_cost_usd", "max_runtime_minutes", "max_retries", "max_samples", "worker_count", "worker_vcpus", "worker_gpu_count", "total_spot_vcpus", "partitioning", "interruption_policy", "minimum_p10_output_tokens_per_second", "throughput_samples_per_rung", "output_tokens_per_sample", "warmup_samples_per_rung", "p10_method", "rungs", "bound_hashes"],
    "properties": {
        "record_kind": {"const": "cloud_pilot_protocol"},
        "schema_version": {"const": "0.2.0"},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
        "max_runtime_minutes": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "max_samples": {"type": "integer", "minimum": 20},
        "worker_count": {"const": 2},
        "worker_vcpus": {"const": 8},
        "worker_gpu_count": {"const": 1},
        "total_spot_vcpus": {"const": 16},
        "partitioning": {"const": "canonical_round_robin"},
        "interruption_policy": {"const": "freeze_and_resume"},
        "minimum_p10_output_tokens_per_second": {"const": 8.0},
        "throughput_samples_per_rung": {"const": 10},
        "output_tokens_per_sample": {"const": 128},
        "warmup_samples_per_rung": {"const": 1},
        "p10_method": {"const": "nearest_rank"},
        "rungs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "bound_hashes": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "additionalProperties": false
}
