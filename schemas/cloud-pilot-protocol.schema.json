{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-pilot-protocol.schema.json",
    "title": "Cloud Pilot Protocol",
    "description": "Frozen admission protocol only; it does not authorize or record a pilot execution.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "max_cost_usd", "max_runtime_minutes", "max_retries", "max_samples", "minimum_p10_output_tokens_per_second", "rungs", "bound_hashes"],
    "properties": {"record_kind": {"const": "cloud_pilot_protocol"}, "schema_version": {"const": "0.1.0"}, "max_cost_usd": {"type": "number", "exclusiveMinimum": 0}, "max_runtime_minutes": {"type": "integer", "minimum": 1}, "max_retries": {"type": "integer", "minimum": 0}, "max_samples": {"type": "integer", "minimum": 1}, "minimum_p10_output_tokens_per_second": {"type": "number", "exclusiveMinimum": 0, "description": "Preregistered p10 output-token throughput floor. Its absence leaves a protocol incomplete and cannot be replaced by an arbitrary positive observation."}, "rungs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "bound_hashes": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "additionalProperties": false
}
