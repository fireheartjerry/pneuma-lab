{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-production-provider-binding.schema.json",
    "title": "Production Provider Binding",
    "description": "Concrete provider/deployment binding for the real role surface. It is not an execution authorization.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "provider", "region", "production_deployment", "bounded_surface_deployment", "forbidden_actions", "teardown", "image_registry"],
    "properties": {
        "record_kind": {"const": "cloud_production_provider_binding"},
        "schema_version": {"const": "0.1.0"},
        "provider": {"const": "aws"},
        "region": {"const": "us-east-1"},
        "production_deployment": {"$ref": "#/$defs/production"},
        "bounded_surface_deployment": {"$ref": "#/$defs/surface"},
        "forbidden_actions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "teardown": {
            "type": "object",
            "required": ["required", "active_resource_absence", "retained_artifacts"],
            "properties": {
                "required": {"const": true},
                "active_resource_absence": {"const": true},
                "retained_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["immutable_ecr_images", "sbom_records", "compact_receipts"]}}
            },
            "additionalProperties": false
        },
        "image_registry": {
            "type": "object",
            "required": ["repository_prefix", "tag_mutability", "scan_on_push", "encryption"],
            "properties": {
                "repository_prefix": {"const": "pneuma-official-production"},
                "tag_mutability": {"const": "IMMUTABLE"},
                "scan_on_push": {"const": true},
                "encryption": {"const": "AES256"}
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "$defs": {
        "production": {
            "type": "object",
            "required": ["deployment_id", "instance_type", "worker_count", "spot_only", "max_attempts", "official_topology"],
            "properties": {
                "deployment_id": {"const": "aws-batch-two-independent-g6e-spot-workers-v1"},
                "instance_type": {"const": "g6e.2xlarge"},
                "worker_count": {"const": 2},
                "spot_only": {"const": true},
                "max_attempts": {"const": 1},
                "official_topology": {"const": "two-independent-8-vcpu-one-l40s-workers"}
            },
            "additionalProperties": false
        },
        "surface": {
            "type": "object",
            "required": ["deployment_id", "instance_type", "capacity_type", "max_duration_seconds", "max_usd", "network", "metadata_options", "role_sandbox"],
            "properties": {
                "deployment_id": {"const": "aws-ec2-ssm-cpu-production-role-surface-v1"},
                "instance_type": {"const": "m7i.large"},
                "capacity_type": {"const": "on-demand"},
                "max_duration_seconds": {"const": 900},
                "max_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
                "network": {"const": "no-inbound-egress-ssm-ecr-only"},
                "metadata_options": {"const": "IMDSv2-required"},
                "role_sandbox": {"const": "network-none-read-only-cap-drop-all-no-new-privileges"}
            },
            "additionalProperties": false
        }
    }
}
