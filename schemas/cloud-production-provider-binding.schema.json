{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-production-provider-binding.schema.json",
    "title": "Production Provider Binding",
    "description": "Concrete provider/deployment binding for the real role surface. It is not an execution authorization.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.2.0",
    "required": ["record_kind", "schema_version", "provider", "region", "production_deployment", "bounded_surface_deployment", "forbidden_actions_scope", "forbidden_actions", "teardown", "image_registry"],
    "properties": {
        "record_kind": {"const": "cloud_production_provider_binding"},
        "schema_version": {"const": "0.2.0"},
        "provider": {"const": "aws"},
        "region": {"const": "us-east-1"},
        "production_deployment": {"$ref": "#/$defs/production"},
        "bounded_surface_deployment": {"$ref": "#/$defs/surface"},
        "forbidden_actions_scope": {"const": "bounded_surface_deployment_only"},
        "forbidden_actions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "teardown": {
            "type": "object",
            "required": ["required", "active_resource_absence", "retained_artifacts"],
            "properties": {
                "required": {"const": true},
                "active_resource_absence": {"const": true},
                "retained_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["immutable_ecr_images", "sbom_records", "compact_receipts"]}}
            },
            "additionalProperties": false
        },
        "image_registry": {
            "type": "object",
            "required": ["repository_prefix", "tag_mutability", "scan_on_push", "encryption"],
            "properties": {
                "repository_prefix": {"const": "pneuma-official-production"},
                "tag_mutability": {"const": "IMMUTABLE"},
                "scan_on_push": {"const": true},
                "encryption": {"const": "AES256"}
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "$defs": {
        "production": {
            "type": "object",
            "required": ["deployment_id", "instance_type", "worker_count", "spot_only", "max_attempts", "official_topology", "allowed_actions"],
            "properties": {
                "deployment_id": {"const": "aws-batch-two-independent-g6e-spot-workers-v1"},
                "instance_type": {"const": "g6e.2xlarge"},
                "worker_count": {"const": 2},
                "spot_only": {"const": true},
                "max_attempts": {"const": 1},
                "official_topology": {"const": "two-independent-8-vcpu-one-l40s-workers"},
                "allowed_actions": {
                    "const": ["official_model", "approved_benchmark", "canonical_p0_grid", "task_block_execution", "sealed_output_publication"]
                }
            },
            "additionalProperties": false
        },
        "surface": {
            "type": "object",
            "required": ["deployment_id", "instance_type", "capacity_type", "max_duration_seconds", "max_usd", "network", "metadata_options", "role_sandbox", "vpc_id", "availability_zone", "subnet_cidr", "ami_id", "ami_owner_id", "architecture", "root_device_type", "approved_endpoints", "custom_ssm_document", "external_watchdog"],
            "properties": {
                "deployment_id": {"const": "aws-ec2-ssm-cpu-production-role-surface-v2"},
                "instance_type": {"const": "m7i.large"},
                "capacity_type": {"const": "on-demand"},
                "max_duration_seconds": {"const": 900},
                "max_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
                "network": {"const": "private-action-subnet-approved-endpoints-only"},
                "metadata_options": {"const": "IMDSv2-required"},
                "role_sandbox": {"const": "network-none-read-only-cap-drop-all-no-new-privileges"},
                "vpc_id": {"const": "vpc-0577decd080525e86"},
                "availability_zone": {"const": "us-east-1a"},
                "subnet_cidr": {"const": "10.42.2.0/24"},
                "ami_id": {"const": "ami-0b416d150bdde5ea2"},
                "ami_owner_id": {"const": "591542846629"},
                "architecture": {"const": "x86_64"},
                "root_device_type": {"const": "ebs"},
                "approved_endpoints": {"type": "array", "items": {"enum": ["ecr.api", "ecr.dkr", "ssm", "ssmmessages", "ec2messages", "s3"]}, "minItems": 6, "maxItems": 6, "uniqueItems": true},
                "custom_ssm_document": {"type": "object", "required": ["contract", "version", "caller_parameters"], "properties": {"contract": {"const": "fixed-status-read-v1"}, "version": {"const": "1"}, "caller_parameters": {"const": false}}, "additionalProperties": false},
                "external_watchdog": {"const": true}
            },
            "additionalProperties": false
        }
    }
}
