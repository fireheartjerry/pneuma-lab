{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-official-rng-commitment.schema.json",
    "title": "Pending Official RNG Commitments",
    "description": "The registered RNG derivation contract with external commitments intentionally unrevealed.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "study_id", "status", "contract_id", "frame_contract", "commitments", "reveals"],
    "properties": {
        "record_kind": {"const": "cloud_official_rng_commitment"},
        "schema_version": {"const": "0.1.0"},
        "study_id": {"const": "neurips-2026-resampling-null"},
        "status": {"const": "pending_commitments"},
        "contract_id": {"const": "official-study-rng-v1"},
        "frame_contract": {
            "type": "object",
            "required": ["frame_id", "commitment_frame", "derivation_domains", "root_status"],
            "properties": {
                "frame_id": {"const": "pneuma-resampling-null-frame-v1"},
                "commitment_frame": {"const": "commitment-v1"},
                "derivation_domains": {"const": ["roster", "schedule", "assignment", "model", "benchmark", "unblind"]},
                "root_status": {"const": "revealed_only_after_external_authority"}
            },
            "additionalProperties": false
        },
        "commitments": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
                "type": "object",
                "required": ["label", "representation", "commitment_status"],
                "properties": {
                    "label": {"enum": ["roster-local-nonce", "schedule-seed", "assignment-master-key"]},
                    "representation": {"enum": ["bytes32", "u64", "bytes32"]},
                    "commitment_status": {"const": "pending_external_precommit"}
                },
                "additionalProperties": false
            },
            "uniqueItems": true
        },
        "reveals": {"const": null}
    },
    "additionalProperties": false
}
