{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/instinct-signal.schema.json",
    "title": "InstinctSignal",
    "description": "Fast scar/motif/anomaly detection over the live run-event stream. Structured signal FIRST; the human-readable gloss is generated only AFTER the structured signal exists ('show receipts') — never 'I feel anxious about this patch'. Instinct requests authority but is never sovereign. Output contract v0.1. Mirrors human_nature/instinct_signal.py exactly, extended with lab-eval fields.",
    "type": "object",
    "x-pneuma-frame-kind": "output",
    "x-pneuma-version": "0.1.0",
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "0.1.0"
        },
        "frame_kind": {
            "type": "string",
            "const": "instinct_signal"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "run_id": {
            "type": "string"
        },
        "motif_id": {
            "type": "string",
            "description": "e.g. 'scar.patch-large-tests-skipped-regression'."
        },
        "match_type": {
            "type": "string",
            "description": "How the live prefix matched a known trajectory.",
            "enum": [
                "exact",
                "prefix",
                "near_duplicate",
                "anomaly"
            ]
        },
        "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
        },
        "severity": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
        },
        "matched_events": {
            "type": "array",
            "description": "The live event-stream events that triggered the match (evidence_events in the runtime dataclass).",
            "items": {
                "type": [
                    "string",
                    "object"
                ]
            }
        },
        "historical_base_rate": {
            "type": [
                "number",
                "null"
            ],
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "How often this motif historically preceded the bad outcome."
        },
        "false_positive_rate": {
            "type": [
                "number",
                "null"
            ],
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Learned FP rate for this motif (drives scar decay / trust)."
        },
        "recommended_action": {
            "type": "string",
            "enum": [
                "pause",
                "simplify",
                "deepen_verification",
                "force_replan",
                "reduce_diff",
                "switch_strategy",
                "continue_fast_path"
            ]
        },
        "expected_loss_if_ignored": {
            "type": "number",
            "description": "Estimated cost of ignoring the signal."
        },
        "time_sensitivity": {
            "type": [
                "number",
                "null"
            ],
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "How soon the recommended action must be taken to matter."
        },
        "authority_request": {
            "type": "string",
            "description": "Discrete authority the signal requests (passes through the 5-cap gate; instinct is never sovereign).",
            "enum": [
                "soft",
                "vote",
                "hold"
            ]
        },
        "matched_history_refs": {
            "type": "array",
            "description": "References to the historical runs/scars this matched.",
            "items": {
                "type": "string"
            }
        },
        "explanation_trace_id": {
            "type": [
                "string",
                "null"
            ],
            "description": "Ref to the CausalTrace justifying this signal (receipts)."
        }
    },
    "required": [
        "schema_version",
        "frame_kind",
        "motif_id",
        "match_type",
        "confidence",
        "severity",
        "recommended_action",
        "authority_request"
    ],
    "additionalProperties": true
}
