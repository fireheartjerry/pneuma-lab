{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/foundation-suite-report.schema.json",
    "title": "Pneuma Foundation Dataset Suite Report",
    "description": "Filesystem-metadata-only completeness report for the exact ordered foundation dataset policy matrix.",
    "type": "object",
    "x-pneuma-schema-kind": "foundation-suite-report",
    "x-pneuma-version": "0.1.0",
    "required": [
        "manifest_kind",
        "manifest_schema_version",
        "first_stage",
        "evaluation_identity",
        "families"
    ],
    "properties": {
        "manifest_kind": {
            "const": "pneuma_foundation_suite_report"
        },
        "manifest_schema_version": {
            "const": "0.1.0"
        },
        "first_stage": {
            "type": "object",
            "required": ["stage", "authorized_lane_candidates"],
            "properties": {
                "stage": {
                    "const": "100k"
                },
                "authorized_lane_candidates": {
                    "const": ["swe-gym-openhands-sampled"]
                }
            },
            "additionalProperties": false
        },
        "evaluation_identity": {
            "type": "object",
            "required": ["required_families", "blocked_unavailable_families"],
            "properties": {
                "required_families": {
                    "const": ["swe-bench", "swe-mera", "swe-polybench"]
                },
                "blocked_unavailable_families": {
                    "const": ["swe-bench-pro"]
                }
            },
            "additionalProperties": false
        },
        "families": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "prefixItems": [
                {
                    "$ref": "#/$defs/multi_swe_bench"
                },
                {
                    "$ref": "#/$defs/open_swe_traces"
                },
                {
                    "$ref": "#/$defs/sec_bench_pro"
                },
                {
                    "$ref": "#/$defs/swe_bench"
                },
                {
                    "$ref": "#/$defs/swe_bench_pro"
                },
                {
                    "$ref": "#/$defs/swe_chat"
                },
                {
                    "$ref": "#/$defs/swe_evo"
                },
                {
                    "$ref": "#/$defs/swe_gym"
                },
                {
                    "$ref": "#/$defs/swe_mera"
                },
                {
                    "$ref": "#/$defs/swe_polybench"
                }
            ],
            "items": false,
            "unevaluatedItems": false
        }
    },
    "$defs": {
        "family_presence": {
            "type": "object",
            "required": [
                "family",
                "terminal_role",
                "gradient_eligibility",
                "payload_access_100k",
                "payload_access_500k",
                "exists",
                "file_count",
                "byte_count",
                "newest_mtime_ns",
                "inspection",
                "payload_opened"
            ],
            "properties": {
                "family": {
                    "type": "string"
                },
                "terminal_role": {
                    "type": "string"
                },
                "gradient_eligibility": {
                    "type": "string"
                },
                "payload_access_100k": {
                    "type": "string"
                },
                "payload_access_500k": {
                    "type": "string"
                },
                "exists": {
                    "type": "boolean"
                },
                "file_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "byte_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "newest_mtime_ns": {
                    "type": ["integer", "null"],
                    "minimum": 0
                },
                "inspection": {
                    "const": "filesystem_metadata_only"
                },
                "payload_opened": {
                    "const": false
                }
            }
        },
        "multi_swe_bench": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "properties": {
                        "family": {
                            "const": "multi-swe-bench"
                        },
                        "terminal_role": {
                            "const": "train"
                        },
                        "gradient_eligibility": {
                            "const": "later"
                        },
                        "payload_access_100k": {
                            "const": "metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "metadata_only"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "open_swe_traces": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "properties": {
                        "family": {
                            "const": "open-swe-traces"
                        },
                        "terminal_role": {
                            "const": "train"
                        },
                        "gradient_eligibility": {
                            "const": "later"
                        },
                        "payload_access_100k": {
                            "const": "metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "metadata_only"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "sec_bench_pro": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "properties": {
                        "family": {
                            "const": "sec-bench-pro"
                        },
                        "terminal_role": {
                            "const": "governance"
                        },
                        "gradient_eligibility": {
                            "const": "never"
                        },
                        "payload_access_100k": {
                            "const": "metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "metadata_only"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "swe_bench": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "required": ["identity_metadata_relative_path"],
                    "properties": {
                        "family": {
                            "const": "swe-bench"
                        },
                        "terminal_role": {
                            "const": "eval"
                        },
                        "gradient_eligibility": {
                            "const": "never"
                        },
                        "payload_access_100k": {
                            "const": "identity_metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "identity_metadata_only"
                        },
                        "identity_metadata_relative_path": {
                            "const": "processed/swe-bench/normalized_metadata.jsonl"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "swe_bench_pro": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "properties": {
                        "family": {
                            "const": "swe-bench-pro"
                        },
                        "terminal_role": {
                            "const": "eval"
                        },
                        "gradient_eligibility": {
                            "const": "never"
                        },
                        "payload_access_100k": {
                            "const": "metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "metadata_only"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "swe_chat": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "properties": {
                        "family": {
                            "const": "swe-chat"
                        },
                        "terminal_role": {
                            "const": "governance"
                        },
                        "gradient_eligibility": {
                            "const": "never"
                        },
                        "payload_access_100k": {
                            "const": "metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "metadata_only"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "swe_evo": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "properties": {
                        "family": {
                            "const": "swe-evo"
                        },
                        "terminal_role": {
                            "const": "train"
                        },
                        "gradient_eligibility": {
                            "const": "later"
                        },
                        "payload_access_100k": {
                            "const": "metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "metadata_only"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "swe_gym": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "properties": {
                        "family": {
                            "const": "swe-gym"
                        },
                        "terminal_role": {
                            "const": "train"
                        },
                        "gradient_eligibility": {
                            "const": "first_stage"
                        },
                        "payload_access_100k": {
                            "const": "approved_processed_lane_only"
                        },
                        "payload_access_500k": {
                            "const": "approved_processed_lane_only"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "swe_mera": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "required": ["identity_metadata_relative_path"],
                    "properties": {
                        "family": {
                            "const": "swe-mera"
                        },
                        "terminal_role": {
                            "const": "eval"
                        },
                        "gradient_eligibility": {
                            "const": "never"
                        },
                        "payload_access_100k": {
                            "const": "identity_metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "identity_metadata_only"
                        },
                        "identity_metadata_relative_path": {
                            "const": "processed/swe-mera/normalized_metadata.jsonl"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "swe_polybench": {
            "allOf": [
                {
                    "$ref": "#/$defs/family_presence"
                },
                {
                    "required": ["identity_metadata_relative_path"],
                    "properties": {
                        "family": {
                            "const": "swe-polybench"
                        },
                        "terminal_role": {
                            "const": "eval"
                        },
                        "gradient_eligibility": {
                            "const": "later"
                        },
                        "payload_access_100k": {
                            "const": "identity_metadata_only"
                        },
                        "payload_access_500k": {
                            "const": "identity_metadata_only"
                        },
                        "identity_metadata_relative_path": {
                            "const": "processed/swe-polybench/normalized_metadata.jsonl"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        }
    },
    "additionalProperties": false
}
