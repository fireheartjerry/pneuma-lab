{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-production-execution-surface.schema.json",
    "title": "Cloud Production Execution Surface",
    "description": "Exact three-role executable and E2E receipt set required before launch review.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "input_lock_sha256", "source_commit", "roles"],
    "properties": {
        "record_kind": {"const": "cloud_production_execution_surface"},
        "schema_version": {"enum": ["0.1.0", "0.2.0"]},
        "input_lock_sha256": {"$ref": "#/$defs/digest"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "provider_binding_sha256": {"$ref": "#/$defs/digest"},
        "e2e_class": {"const": "non_scientific_bounded_surface"},
        "deployment_id": {"type": "string", "minLength": 1},
        "teardown_ref": {"$ref": "#/$defs/digest"},
        "surface_class": {"const": "provenance_verified_official_batch_plan"},
        "launch_plan_sha256": {"$ref": "#/$defs/digest"},
        "roles": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
                "type": "object",
                "required": ["role", "image_digest", "entrypoint", "source_sha256"],
                "properties": {
                    "role": {"enum": ["controller", "model-server", "benchmark-worker"]},
                    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                    "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "source_sha256": {"$ref": "#/$defs/digest"},
                    "e2e_receipt_sha256": {"$ref": "#/$defs/digest"},
                    "sbom_sha256": {"$ref": "#/$defs/digest"},
                    "provenance_descriptor_digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "gates": {
                        "type": "object",
                        "required": ["clean_start", "expected_terminal_state", "failure_receipt", "no_class_a_secret", "no_controller_credentials", "imds_blocked", "docker_socket_absent"],
                        "properties": {
                            "clean_start": {"const": true},
                            "expected_terminal_state": {"const": true},
                            "failure_receipt": {"const": true},
                            "no_class_a_secret": {"const": true},
                            "no_controller_credentials": {"type": "boolean"},
                            "imds_blocked": {"const": true},
                            "docker_socket_absent": {"type": "boolean"}
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
