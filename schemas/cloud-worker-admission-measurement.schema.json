{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-worker-admission-measurement.schema.json",
    "title": "Cloud Worker Admission Measurement",
    "description": "Complete per-worker, per-rung non-efficacy observations used to compile a pilot admission receipt; it is neither an authorization nor a scientific result.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.2.0",
    "required": ["record_kind", "schema_version", "protocol_sha256", "architecture_sha256", "authorization_sha256", "image_sha256", "input_lock_sha256", "code_sha256", "worker_index", "instance_id", "runtime", "rungs"],
    "properties": {
        "record_kind": {"const": "cloud_worker_admission_measurement"},
        "schema_version": {"const": "0.2.0"},
        "protocol_sha256": {"$ref": "#/$defs/digest"},
        "architecture_sha256": {"$ref": "#/$defs/digest"},
        "authorization_sha256": {"$ref": "#/$defs/digest"},
        "image_sha256": {"$ref": "#/$defs/digest"},
        "input_lock_sha256": {"$ref": "#/$defs/digest"},
        "code_sha256": {"$ref": "#/$defs/digest"},
        "worker_index": {"enum": [0, 1]},
        "instance_id": {"type": "string", "pattern": "^i-[0-9a-f]{8,17}$"},
        "runtime": {
            "type": "object",
            "required": ["model", "revision", "cuda_name", "cuda_total_memory_bytes", "torch_version", "vllm_version"],
            "properties": {
                "model": {"type": "string", "minLength": 1},
                "revision": {"type": "string", "minLength": 1},
                "cuda_name": {"type": "string", "minLength": 1},
                "cuda_total_memory_bytes": {"type": "integer", "minimum": 1},
                "torch_version": {"type": "string", "minLength": 1},
                "vllm_version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
        },
        "rungs": {
            "type": "object",
            "required": ["l40s-tp1-32768", "l40s-tp1-65536"],
            "properties": {
                "l40s-tp1-32768": {"$ref": "#/$defs/rung"},
                "l40s-tp1-65536": {"$ref": "#/$defs/rung"}
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "$defs": {
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tokenIds": {
            "type": "array",
            "minItems": 32,
            "maxItems": 32,
            "items": {"type": "integer", "minimum": 0}
        },
        "throughputSample": {
            "type": "object",
            "required": ["index", "elapsed_seconds", "generated_tokens", "output_token_ids_sha256"],
            "properties": {
                "index": {"type": "integer", "minimum": 0},
                "elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
                "generated_tokens": {"const": 128},
                "output_token_ids_sha256": {"$ref": "#/$defs/digest"}
            },
            "additionalProperties": false
        },
        "throughput": {
            "type": "object",
            "required": ["p10_method", "warmup_samples", "output_tokens_per_sample", "samples"],
            "properties": {
                "p10_method": {"const": "nearest_rank"},
                "warmup_samples": {"const": 1},
                "output_tokens_per_sample": {"const": 128},
                "samples": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/throughputSample"}}
            },
            "additionalProperties": false
        },
        "toolCall": {
            "type": "object",
            "required": ["fixture_id", "raw_response_text", "name", "arguments"],
            "properties": {
                "fixture_id": {"type": "string", "minLength": 1},
                "raw_response_text": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "arguments": {"type": "object"}
            },
            "additionalProperties": false
        },
        "outputParity": {
            "type": "object",
            "required": ["fixture_id", "first_output_token_ids", "second_output_token_ids"],
            "properties": {
                "fixture_id": {"type": "string", "minLength": 1},
                "first_output_token_ids": {"$ref": "#/$defs/tokenIds"},
                "second_output_token_ids": {"$ref": "#/$defs/tokenIds"}
            },
            "additionalProperties": false
        },
        "rung": {
            "type": "object",
            "required": ["peak_allocated_bytes", "throughput", "tool_calls", "output_parity"],
            "properties": {
                "peak_allocated_bytes": {"type": "integer", "minimum": 0},
                "throughput": {"$ref": "#/$defs/throughput"},
                "tool_calls": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/toolCall"}},
                "output_parity": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/outputParity"}}
            },
            "additionalProperties": false
        }
    }
}
