{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/resampling-branch-program-registry.schema.json",
    "title": "Resampling-Null Branch Program Registry",
    "description": "Immutable pre-schedule task/ordinal authority for synthetic branch execution programs.",
    "type": "object",
    "x-pneuma-schema-kind": "resampling-branch-program-authority",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "tasks"],
    "properties": {
        "record_kind": {
            "const": "resampling_branch_program_registry_v1"
        },
        "schema_version": {
            "const": "0.1.0"
        },
        "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["task_id", "programs"],
                "properties": {
                    "task_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "programs": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "prefixItems": [
                            {
                                "$ref": "#/$defs/program_0"
                            },
                            {
                                "$ref": "#/$defs/program_1"
                            },
                            {
                                "$ref": "#/$defs/program_2"
                            },
                            {
                                "$ref": "#/$defs/program_3"
                            }
                        ],
                        "items": false
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "artifact_ref": {
            "type": "object",
            "required": [
                "role",
                "relative_path",
                "sha256",
                "byte_count",
                "media_type"
            ],
            "properties": {
                "role": {
                    "const": "synthetic_execution_program"
                },
                "relative_path": {
                    "type": "string",
                    "minLength": 1
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "byte_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "media_type": {
                    "const": "application/json"
                }
            },
            "additionalProperties": false
        },
        "program_0": {
            "$ref": "#/$defs/program_entry",
            "properties": {
                "branch_ordinal": {
                    "const": 0
                }
            }
        },
        "program_1": {
            "$ref": "#/$defs/program_entry",
            "properties": {
                "branch_ordinal": {
                    "const": 1
                }
            }
        },
        "program_2": {
            "$ref": "#/$defs/program_entry",
            "properties": {
                "branch_ordinal": {
                    "const": 2
                }
            }
        },
        "program_3": {
            "$ref": "#/$defs/program_entry",
            "properties": {
                "branch_ordinal": {
                    "const": 3
                }
            }
        },
        "program_entry": {
            "type": "object",
            "required": ["branch_ordinal", "program_ref"],
            "properties": {
                "branch_ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                },
                "program_ref": {
                    "$ref": "#/$defs/artifact_ref"
                }
            },
            "additionalProperties": false
        }
    }
}
