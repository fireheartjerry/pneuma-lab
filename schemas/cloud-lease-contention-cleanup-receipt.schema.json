{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-lease-contention-cleanup-receipt.schema.json",
    "title": "Cloud Lease Contention Cleanup Receipt",
    "description": "Exact cleanup evidence for a failed DynamoDB lease qualification; never a scientific result.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": [
        "record_kind", "schema_version", "plan_sha256", "input_lock_sha256", "provider", "region",
        "account_id", "cleanup_id", "target_action_id", "table_name", "table_arn", "lease_key",
        "expected_owner", "identity_arn", "preflight", "deletion", "final", "gates",
        "residual_resource_ids", "no_scientific_action", "verdict"
    ],
    "properties": {
        "record_kind": {"const": "cloud_lease_contention_cleanup_receipt"},
        "schema_version": {"const": "0.1.0"},
        "plan_sha256": {"$ref": "#/$defs/digest"},
        "input_lock_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "provider": {"const": "aws"},
        "region": {"type": "string", "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-\\d$"},
        "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
        "cleanup_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "target_action_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "table_name": {"type": "string", "minLength": 1},
        "table_arn": {"type": "string", "pattern": "^arn:aws:dynamodb:[^:]+:[0-9]{12}:table/.+"},
        "lease_key": {"type": "string", "minLength": 1},
        "expected_owner": {"type": "string", "minLength": 1},
        "identity_arn": {"type": "string", "minLength": 1},
        "preflight": {
            "type": "object",
            "required": ["table_active", "table_arn_exact", "item_present", "owner_exact", "action_id_exact"],
            "properties": {
                "table_active": {"type": "boolean"},
                "table_arn_exact": {"type": "boolean"},
                "item_present": {"type": "boolean"},
                "owner_exact": {"type": "boolean"},
                "action_id_exact": {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "deletion": {
            "type": "object",
            "required": ["attempted", "succeeded", "return_code", "stdout_sha256", "stderr_sha256"],
            "properties": {
                "attempted": {"type": "boolean"},
                "succeeded": {"type": "boolean"},
                "return_code": {"type": "integer"},
                "stdout_sha256": {"$ref": "#/$defs/digest"},
                "stderr_sha256": {"$ref": "#/$defs/digest"}
            },
            "additionalProperties": false
        },
        "final": {
            "type": "object",
            "required": ["item_absent", "table_count"],
            "properties": {
                "item_absent": {"type": "boolean"},
                "table_count": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
        },
        "gates": {
            "type": "object",
            "required": ["identity_bound", "exact_item_bound", "delete_succeeded", "final_absent", "no_retries", "no_scientific_action"],
            "properties": {
                "identity_bound": {"type": "boolean"},
                "exact_item_bound": {"type": "boolean"},
                "delete_succeeded": {"type": "boolean"},
                "final_absent": {"type": "boolean"},
                "no_retries": {"type": "boolean"},
                "no_scientific_action": {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "residual_resource_ids": {"type": "array", "maxItems": 0},
        "no_scientific_action": {"const": true},
        "verdict": {"enum": ["passed", "failed"]},
        "failure_reason": {"type": ["string", "null"]}
    },
    "additionalProperties": false,
    "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
