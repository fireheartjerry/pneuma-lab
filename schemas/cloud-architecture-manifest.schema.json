{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-architecture-manifest.schema.json",
    "title": "Cloud Architecture Manifest",
    "description": "Tier-agnostic static two-worker AWS Spot architecture contract; not a deployment plan or authorization.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.2.0",
    "required": ["record_kind", "schema_version", "region", "tier", "compute", "storage", "lease", "controller_policy", "watcher_policy"],
    "properties": {
        "record_kind": {"const": "cloud_architecture_manifest"},
        "schema_version": {"const": "0.2.0"},
        "region": {"const": "us-east-1"},
        "tier": {"type": "string", "minLength": 1},
        "compute": {
            "type": "object",
            "required": ["instance_type", "max_vcpus", "min_vcpus", "worker_count", "worker_vcpus", "worker_gpu_count", "total_gpu_count", "usable_gpu_memory_gib", "allocation_strategy", "partitioning", "interruption_policy", "ami_id", "root_snapshot_id", "bootstrap_sha256"],
            "properties": {
                "instance_type": {"const": "g6e.2xlarge"},
                "max_vcpus": {"const": 16},
                "min_vcpus": {"const": 0},
                "worker_count": {"const": 2},
                "worker_vcpus": {"const": 8},
                "worker_gpu_count": {"const": 1},
                "total_gpu_count": {"const": 2},
                "usable_gpu_memory_gib": {"const": 44},
                "allocation_strategy": {"const": "SPOT_PRICE_CAPACITY_OPTIMIZED"},
                "partitioning": {"const": "canonical_round_robin"},
                "interruption_policy": {"const": "freeze_and_resume"},
                "ami_id": {"type": "string", "minLength": 1},
                "root_snapshot_id": {"type": "string", "minLength": 1},
                "bootstrap_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
        },
        "storage": {"$ref": "#/$defs/storage"},
        "lease": {"$ref": "#/$defs/lease"},
        "controller_policy": {"$ref": "#/$defs/policy"},
        "watcher_policy": {"$ref": "#/$defs/policy"}
    },
    "additionalProperties": false,
    "$defs": {
        "storage": {
            "type": "object",
            "required": ["bucket_prefix", "lifecycle_policy_id", "absolute_deletion_date"],
            "properties": {
                "bucket_prefix": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/-]*$"},
                "lifecycle_policy_id": {"type": "string", "minLength": 1},
                "absolute_deletion_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
            },
            "additionalProperties": false
        },
        "lease": {
            "type": "object",
            "required": ["table", "key"],
            "properties": {
                "table": {"type": "string", "minLength": 1},
                "key": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
        },
        "policy": {
            "type": "object",
            "required": ["identity", "actions"],
            "properties": {
                "identity": {"type": "string", "minLength": 1},
                "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
            },
            "additionalProperties": false
        }
    }
}
