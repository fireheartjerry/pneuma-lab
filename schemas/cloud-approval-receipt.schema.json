{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-approval-receipt.schema.json",
    "title": "Cloud Approval Receipt",
    "description": "Local approval binding receipt; not a human approval or provider receipt.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "authorization_sha256", "manifest_sha256"],
    "properties": {"record_kind": {"const": "cloud_approval_receipt"}, "schema_version": {"const": "0.1.0"}, "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "additionalProperties": false
}
