{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-unattended-spend-policy.schema.json",
    "title": "Cloud Unattended Spend Policy",
    "description": "Human-readable standing authority envelope. Digests are controller-generated receipts, never operator approval phrases.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "policy_id", "status", "providers", "allowed_action_classes", "rolling_window_days", "rolling_ceiling_usd", "per_job_ceiling_usd", "max_retries_per_job", "valid_from", "expires_at", "operator_approval"],
    "properties": {
        "record_kind": {"const": "cloud_unattended_spend_policy"},
        "schema_version": {"const": "0.1.0"},
        "policy_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "active", "revoked"]},
        "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["openai", "aws", "azure"]}},
        "allowed_action_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["bounded_retrieval", "non_scientific_smoke", "bounded_api_pilot"]}},
        "rolling_window_days": {"const": 30},
        "rolling_ceiling_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 25},
        "per_job_ceiling_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
        "max_retries_per_job": {"type": "integer", "minimum": 0, "maximum": 2},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "operator_approval": {
            "oneOf": [
                {"type": "null"},
                {
                    "type": "object",
                    "required": ["approval_id", "approved_by", "statement"],
                    "properties": {
                        "approval_id": {"type": "string", "minLength": 1},
                        "approved_by": {"type": "string", "minLength": 1},
                        "statement": {"type": "string", "minLength": 1}
                    },
                    "additionalProperties": false
                }
            ]
        }
    },
    "allOf": [
        {"if": {"properties": {"status": {"const": "candidate"}}}, "then": {"properties": {"operator_approval": {"const": null}}}},
        {"if": {"properties": {"status": {"enum": ["active", "revoked"]}}}, "then": {"properties": {"operator_approval": {"type": "object"}}}}
    ],
    "additionalProperties": false
}
