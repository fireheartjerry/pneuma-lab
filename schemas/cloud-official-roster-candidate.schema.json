{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-official-roster-candidate.schema.json",
    "title": "Official Roster Candidate",
    "description": "Real selection evidence carried forward as a pre-ceremony candidate; it is not eligible-confirmation authority.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "study_id", "status", "synthetic_authority", "ceremony_status", "authority_sha256", "input_lock_sha256", "selection_refs", "closure_ref", "isolation_ref", "eligible_confirmation_ref"],
    "properties": {
        "record_kind": {"const": "cloud_official_roster_candidate"},
        "schema_version": {"const": "0.1.0"},
        "study_id": {"const": "neurips-2026-resampling-null"},
        "status": {"const": "candidate_prelaunch"},
        "synthetic_authority": {"const": false},
        "ceremony_status": {"const": "not_performed"},
        "authority_sha256": {"$ref": "#/$defs/sha256"},
        "input_lock_sha256": {"$ref": "#/$defs/sha256"},
        "selection_refs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"$ref": "#/$defs/file_ref"}
        },
        "closure_ref": {"$ref": "#/$defs/file_ref"},
        "isolation_ref": {"$ref": "#/$defs/file_ref"},
        "eligible_confirmation_ref": {"type": "null"},
        "power_selection_status": {"const": "pending_c120_c160_validation"}
    },
    "additionalProperties": false,
    "$defs": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_ref": {
            "type": "object",
            "required": ["role", "relative_path", "sha256", "byte_count", "media_type"],
            "properties": {
                "role": {"type": "string", "minLength": 1},
                "relative_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "byte_count": {"type": "integer", "minimum": 1},
                "media_type": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
        }
    }
}
