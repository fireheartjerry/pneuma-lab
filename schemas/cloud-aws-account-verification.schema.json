{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-aws-account-verification.schema.json",
    "title": "AWS Account-Bound Verification Receipt",
    "description": "Read-only AWS identity, quota, offering, Terraform show-json, provider-binding, and spend-authority receipt for the two-worker topology; it authorizes no provider mutation.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.2.0",
    "required": ["record_kind", "schema_version", "account_id", "principal_arn", "region", "instance_type", "required_on_demand_vcpus", "required_spot_vcpus", "on_demand_g_vt_vcpus", "spot_g_vt_vcpus", "availability_zones", "qualification_action_id", "terraform_show_sha256", "worker_role_arn", "subnet_ids", "security_group_ids", "spend_history_sha256", "aws_cli_version"],
    "properties": {
        "record_kind": {"const": "cloud_aws_account_verification"},
        "schema_version": {"const": "0.2.0"},
        "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
        "principal_arn": {"type": "string", "pattern": "^arn:(aws|aws-us-gov|aws-cn):(iam|sts)::[0-9]{12}:.+$"},
        "region": {"const": "us-east-1"},
        "instance_type": {"const": "g6e.2xlarge"},
        "required_on_demand_vcpus": {"const": 8},
        "required_spot_vcpus": {"const": 16},
        "on_demand_g_vt_vcpus": {"type": "number", "minimum": 8},
        "spot_g_vt_vcpus": {"type": "number", "minimum": 16},
        "availability_zones": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^us-east-1[a-z]$"}},
        "qualification_action_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "terraform_show_sha256": {"$ref": "#/$defs/digest"},
        "worker_role_arn": {"type": "string", "pattern": "^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/.+$"},
        "subnet_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^subnet-[0-9a-f]+$"}},
        "security_group_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sg-[0-9a-f]+$"}},
        "spend_history_sha256": {"$ref": "#/$defs/digest"},
        "aws_cli_version": {"type": "string", "pattern": "^aws-cli/2\\."}
    },
    "additionalProperties": false,
    "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
