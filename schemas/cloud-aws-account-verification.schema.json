{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-aws-account-verification.schema.json",
    "title": "AWS Account-Bound Verification Receipt",
    "description": "Read-only AWS identity, quota, offering, and Terraform-plan receipt for the approved topology; it authorizes no provider mutation.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "account_id", "principal_arn", "region", "instance_type", "required_vcpus", "on_demand_g_vt_vcpus", "spot_g_vt_vcpus", "availability_zones", "terraform_config_sha256", "terraform_plan_sha256", "aws_cli_version"],
    "properties": {
        "record_kind": {"const": "cloud_aws_account_verification"},
        "schema_version": {"const": "0.1.0"},
        "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
        "principal_arn": {"type": "string", "pattern": "^arn:(aws|aws-us-gov|aws-cn):(iam|sts)::[0-9]{12}:.+$"},
        "region": {"const": "us-east-1"},
        "instance_type": {"const": "g6e.2xlarge"},
        "required_vcpus": {"const": 8},
        "on_demand_g_vt_vcpus": {"type": "number", "minimum": 8},
        "spot_g_vt_vcpus": {"type": "number", "minimum": 8},
        "availability_zones": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^us-east-1[a-z]$"}},
        "terraform_config_sha256": {"$ref": "#/$defs/digest"},
        "terraform_plan_sha256": {"$ref": "#/$defs/digest"},
        "aws_cli_version": {"type": "string", "pattern": "^aws-cli/2\\."}
    },
    "additionalProperties": false,
    "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
