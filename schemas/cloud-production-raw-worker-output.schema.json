{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-production-raw-worker-output.schema.json",
    "title": "Cloud Production Raw Worker Output",
    "description": "Immutable raw per-worker model/benchmark payload. It is evidence input, never a scientific result.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "run_spec_sha256", "worker_id", "tasks"],
    "properties": {
        "record_kind": {"const": "cloud_production_raw_worker_output"},
        "schema_version": {"const": "0.1.0"},
        "run_spec_sha256": {"$ref": "#/$defs/sha256"},
        "worker_id": {"enum": ["worker-0", "worker-1"]},
        "tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "required": ["task_id", "benchmark", "input", "status"],
                "properties": {
                    "task_id": {"type": "string", "minLength": 1},
                    "benchmark": {"enum": ["swe_multilang", "tau2"]},
                    "input": {"type": "object"},
                    "request": {"type": "object"},
                    "model_response": {},
                    "benchmark_output": {},
                    "status": {"enum": ["SUCCEEDED", "FAILED"]},
                    "failure_classification": {"enum": ["OOM", "MODEL_ERROR", "BENCHMARK_ERROR", "PROVIDER_TIMEOUT", "INFRASTRUCTURE_ERROR"]}
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
