{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/resampling-ceremony-receipt.schema.json",
    "title": "Resampling-Null Roster Ceremony Verification Receipt",
    "description": "Signed, externally produced verification receipt binding Sigstore, drand, Node selection, and the exact eligibility manifest. It is required for roster-bound power authority but is not created by the core.",
    "type": "object",
    "x-pneuma-schema-kind": "resampling-study",
    "x-pneuma-version": "1",
    "required": ["record_kind", "schema_version", "study_id", "qualification_universe_sha256", "selection_program_sha256", "precommit_sha256", "anchor_sha256", "reveal_sha256", "eligibility_manifest_sha256", "ceremony_policy_sha256", "sigstore", "drand", "node", "signature_ed25519_hex"],
    "properties": {
        "record_kind": {"const": "resampling_roster_ceremony_receipt_v1"},
        "schema_version": {"const": "1"},
        "study_id": {"type": "string", "minLength": 1},
        "qualification_universe_sha256": {"$ref": "#/$defs/sha256"},
        "selection_program_sha256": {"$ref": "#/$defs/sha256"},
        "precommit_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_sha256": {"$ref": "#/$defs/sha256"},
        "reveal_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "ceremony_policy_sha256": {"$ref": "#/$defs/sha256"},
        "sigstore": {
            "type": "object",
            "required": ["verified", "bundle_sha256", "rekor_entry_sha256", "artifact_sha256", "verifier_source_sha256"],
            "properties": {
                "verified": {"const": true},
                "bundle_sha256": {"$ref": "#/$defs/sha256"},
                "rekor_entry_sha256": {"$ref": "#/$defs/sha256"},
                "artifact_sha256": {"$ref": "#/$defs/sha256"},
                "verifier_source_sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
        },
        "drand": {
            "type": "object",
            "required": ["verified", "chain_hash", "round", "randomness_hex", "randomness_sha256", "proof_sha256"],
            "properties": {
                "verified": {"const": true},
                "chain_hash": {"$ref": "#/$defs/sha256"},
                "round": {"type": "integer", "minimum": 0},
                "randomness_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "randomness_sha256": {"$ref": "#/$defs/sha256"},
                "proof_sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
        },
        "node": {
            "type": "object",
            "required": ["verified", "program_sha256", "output_sha256"],
            "properties": {
                "verified": {"const": true},
                "program_sha256": {"$ref": "#/$defs/sha256"},
                "output_sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
        },
        "signature_ed25519_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
    },
    "additionalProperties": false,
    "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
