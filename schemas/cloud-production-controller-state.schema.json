{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-production-controller-state.schema.json",
    "title": "Cloud Production Controller State",
    "description": "Durable provider-neutral state for an eventual production run. It records submission identity and teardown intent but never submits a provider job by validation alone.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": ["record_kind", "schema_version", "action_id", "run_spec_sha256", "binding", "binding_sha256", "events", "state_sha256"],
    "properties": {
        "record_kind": {"const": "cloud_production_controller_state"},
        "schema_version": {"const": "0.1.0"},
        "action_id": {"type": "string", "minLength": 1},
        "run_spec_sha256": {"$ref": "#/$defs/sha256"},
        "binding": {"type": "object"},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "events": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["sequence", "phase", "payload", "previous_event_sha256", "event_sha256"],
                "properties": {
                    "sequence": {"type": "integer", "minimum": 1},
                    "phase": {"enum": ["prepared", "submitting", "submitted", "observing", "observation_error", "workload_terminal", "teardown_started", "teardown_complete", "teardown_failed"]},
                    "payload": {"type": "object"},
                    "previous_event_sha256": {"$ref": "#/$defs/sha256_or_zero"},
                    "event_sha256": {"$ref": "#/$defs/sha256"}
                },
                "additionalProperties": false
            }
        },
        "state_sha256": {"$ref": "#/$defs/sha256"}
    },
    "additionalProperties": false,
    "$defs": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256_or_zero": {"type": "string", "pattern": "^(?:0{64}|[0-9a-f]{64})$"}
    }
}
