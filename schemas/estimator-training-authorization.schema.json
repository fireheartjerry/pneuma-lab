{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/estimator-training-authorization.schema.json",
    "title": "EstimatorTrainingAuthorization",
    "description": "Human-review authorization artifact for one hash-bound, local-research-only estimator run.",
    "type": "object",
    "x-pneuma-schema-kind": "training-authorization",
    "x-pneuma-version": "0.1.0",
    "required": [
        "authorization_schema_version",
        "authorization_id",
        "run_id",
        "dataset_id",
        "decision",
        "scope",
        "estimators",
        "authorized_code_commit",
        "source_traces_sha256",
        "split_manifest_sha256",
        "artifact_root",
        "reviewer",
        "reviewed_at",
        "release_authorization",
        "runtime_integration"
    ],
    "properties": {
        "authorization_schema_version": {"const": "0.1.0"},
        "authorization_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "dataset_id": {"const": "swe-gym-openhands-sampled"},
        "decision": {"const": "authorized"},
        "scope": {"const": "local_research"},
        "estimators": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"enum": ["e1-v0", "e2-v0"]}
        },
        "authorized_code_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "source_traces_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "split_manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifact_root": {
            "type": "string",
            "pattern": "^build/training_runs/openhands-sampled/[a-z0-9][a-z0-9._-]+/$"
        },
        "reviewer": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "reviewed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "release_authorization": {"const": "not_authorized"},
        "runtime_integration": {"const": "none"}
    },
    "additionalProperties": false
}
