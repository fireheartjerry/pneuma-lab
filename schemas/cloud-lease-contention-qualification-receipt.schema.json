{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pneuma-lab.local/schemas/cloud-lease-contention-qualification-receipt.schema.json",
    "title": "Cloud Lease Contention Qualification Receipt",
    "description": "Real AWS DynamoDB conditional-write contention and exact-item teardown evidence; never a scientific result.",
    "type": "object",
    "x-pneuma-schema-kind": "cloud-manifest",
    "x-pneuma-version": "0.1.0",
    "required": [
        "record_kind", "schema_version", "plan_sha256", "input_lock_sha256", "provider", "region",
        "account_id", "qualification_id", "table_name", "table_arn", "lease_key", "identity_arn",
        "attempt_count", "max_concurrency", "condition_expression", "preflight", "contenders",
        "winner", "cleanup", "gates", "residual_resource_ids", "no_scientific_action", "verdict"
    ],
    "properties": {
        "record_kind": {"const": "cloud_lease_contention_qualification_receipt"},
        "schema_version": {"const": "0.1.0"},
        "plan_sha256": {"$ref": "#/$defs/digest"},
        "input_lock_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "provider": {"const": "aws"},
        "region": {"type": "string", "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-\\d$"},
        "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
        "qualification_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "table_name": {"type": "string", "minLength": 1},
        "table_arn": {"type": "string", "pattern": "^arn:aws:dynamodb:[^:]+:[0-9]{12}:table/.+"},
        "lease_key": {"type": "string", "minLength": 1},
        "identity_arn": {"type": "string", "minLength": 1},
        "attempt_count": {"type": "integer", "minimum": 2, "maximum": 64},
        "max_concurrency": {"type": "integer", "minimum": 2, "maximum": 64},
        "condition_expression": {"const": "attribute_not_exists(lease_key)"},
        "preflight": {
            "type": "object",
            "required": ["table_active", "table_arn_exact", "item_absent", "table_count"],
            "properties": {
                "table_active": {"type": "boolean"},
                "table_arn_exact": {"type": "boolean"},
                "item_absent": {"type": "boolean"},
                "table_count": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
        },
        "contenders": {
            "type": "array",
            "minItems": 2,
            "maxItems": 64,
            "items": {
                "type": "object",
                "required": ["attempt", "owner", "outcome", "return_code", "stdout_sha256", "stderr_sha256", "duration_ms"],
                "properties": {
                    "attempt": {"type": "integer", "minimum": 0},
                    "owner": {"type": "string", "minLength": 1},
                    "outcome": {"enum": ["success", "conditional_failed", "provider_error", "timeout"]},
                    "return_code": {"type": "integer"},
                    "stdout_sha256": {"$ref": "#/$defs/digest"},
                    "stderr_sha256": {"$ref": "#/$defs/digest"},
                    "duration_ms": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
            }
        },
        "winner": {
            "oneOf": [
                {"type": "null"},
                {
                    "type": "object",
                    "required": ["attempt", "owner", "item_sha256", "action_id_exact"],
                    "properties": {
                        "attempt": {"type": "integer", "minimum": 0},
                        "owner": {"type": "string", "minLength": 1},
                        "item_sha256": {"$ref": "#/$defs/digest"},
                        "action_id_exact": {"type": "boolean"}
                    },
                    "additionalProperties": false
                }
            ]
        },
        "cleanup": {
            "type": "object",
            "required": ["delete_attempted", "delete_succeeded", "final_item_absent", "final_table_count"],
            "properties": {
                "delete_attempted": {"type": "boolean"},
                "delete_succeeded": {"type": "boolean"},
                "final_item_absent": {"type": "boolean"},
                "final_table_count": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
        },
        "gates": {
            "type": "object",
            "required": [
                "table_identity_bound", "exactly_one_winner", "all_losers_conditional", "no_provider_errors",
                "winner_readback_exact", "no_retries", "exact_teardown", "no_scientific_action"
            ],
            "properties": {
                "table_identity_bound": {"type": "boolean"},
                "exactly_one_winner": {"type": "boolean"},
                "all_losers_conditional": {"type": "boolean"},
                "no_provider_errors": {"type": "boolean"},
                "winner_readback_exact": {"type": "boolean"},
                "no_retries": {"type": "boolean"},
                "exact_teardown": {"type": "boolean"},
                "no_scientific_action": {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "residual_resource_ids": {"type": "array", "maxItems": 0},
        "no_scientific_action": {"const": true},
        "verdict": {"enum": ["passed", "failed"]},
        "failure_reason": {"type": ["string", "null"]}
    },
    "additionalProperties": false,
    "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
